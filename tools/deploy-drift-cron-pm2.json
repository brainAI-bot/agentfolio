{
  "apps": [
    {
      "name": "agentfolio-deploy-drift-check",
      "script": "tools/deploy-drift-check.js",
      "interpreter": "node",
      "args": "--write-evidence=/home/ubuntu/.agentfolio/reports/deploy-drift-latest.json",
      "cwd": "/home/ubuntu/agentfolio-prod-locked",
      "cron_restart": "17 3 * * *",
      "autorestart": false,
      "watch": false,
      "env": {
        "AGENTFOLIO_PROD_VERSION_URL": "https://agentfolio.bot/api/version",
        "AGENTFOLIO_ORIGIN_REF": "origin/main",
        "AGENTFOLIO_CREATE_DRIFT_TASK": "true",
        "HQ_CLI": "tools/hq-prod-env.sh",
        "HQ_RUNTIME_DIR": "/home/ubuntu/brainai-hq-v4",
        "HQ_AGENT_HOME": "/home/ubuntu",
        "HQ_URL": "http://127.0.0.1:3100",
        "HQ_AGENT_ID": "brainforge"
      },
      "error_file": "/home/ubuntu/.pm2/logs/agentfolio-deploy-drift-error.log",
      "out_file": "/home/ubuntu/.pm2/logs/agentfolio-deploy-drift-out.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
    }
  ]
}
