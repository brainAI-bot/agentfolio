# AgentMail
AGENTMAIL_API_KEY=your_agentmail_api_key_here
AGENTMAIL_INBOX=notifications@example.com

# App runtime
NODE_ENV=production
PORT=3000
AGENTFOLIO_COMMIT_SHA=
AGENTFOLIO_BUILD_TIME=

# Solana RPC endpoints
# /solana-rpc uses only allow-listed JSON-RPC methods and process-local rate limiting.
# Set SOLANA_RPC_PROXY_HELIUS_OPT_IN=true only when this public browser proxy is
# allowed to spend Helius quota. When false, Helius URLs/keys are ignored here.
# Use HELIUS_RPC_URL for the full provider URL, or HELIUS_API_KEY to build the
# default mainnet Helius endpoint without exposing the key to the browser.
# SOLANA_RPC_URL must be a managed mainnet provider endpoint for SATP V3/escrow.
# Keep credentials in environment variables; do not hardcode API keys in source.
SOLANA_RPC_URL=
SOLANA_RPC_PROXY_HELIUS_OPT_IN=false
HELIUS_RPC_URL=
HELIUS_API_KEY=
